APP_TIMEZONE=Asia/Singapore
DATABASE_PATH=/data/semibrief.sqlite3
OUTPUT_DIR=/data/briefs
CONFIG_DIR=/app/config
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
USER_AGENT=SemiBrief/0.1 (+https://github.com/your-org/semiconductor-news-brief)

# Required only for email delivery. Dry runs need none of these.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=news@example.com
EMAIL_TO=recipient@example.com

# Optional self-hosted LibreTranslate endpoint. No LLM tokens are used.
# If unset, non-English items are excluded from the English brief.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

